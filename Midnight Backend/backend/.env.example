# Copy to .env and fill in. .env is git-ignored. Nothing here is hard-coded in the code.

# One or more Groq keys, comma-separated. When one runs out of credit the next
# takes over; when all are out the pipeline pauses (KEY_PAUSE_HOURS) and retries.
GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3

# MongoDB connection string and the database the Lovable app reads ("midnight")
MONGODB_URI=your_mongodb_uri_here
MONGODB_DB=midnight

# Optional
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_REASONING_EFFORT=low       # gpt-oss only: low | medium | high | off
# KEY_PAUSE_HOURS=0.25            # 15 minutes: how long to wait when every work key is out of credit
# FACTCHECK_MODE=balanced         # strict | balanced | light (see README)
# FACTCHECK_LLM=on                # off = skip the second fact-check call (halves credit use; local check stays)
# KEY_PAUSE_HOURS=2
# REPORT_EDITION_TIME_UTC=13:00   # fixed edition time (UTC); writing starts REPORT_LEAD_MINUTES earlier
# REPORT_LEAD_MINUTES=30          # start writing this many minutes before the edition time (12:30 UTC)
# REPORT_EVERY_HOURS=24           # 24-hour safety check: nothing written for this +1 h -> write today's report at once
# --- bulk scrape switches (change both after the bulk scrape is done) -------------------------------------------
SCRAPE_MAX_AGE_DAYS=183           # how far back feeds are read: 183 = six months (bulk scrape). Later set to 1 = last day only
PUBLISHED_AT_MODE=source          # source = each story keeps its original publish time (as before). Later set to: own = our publishing time
# REPORT_MAX_STORIES=12           # most stories the newsletter covers
# FEATURED_COUNT=8                # stories flagged featured:true for the website hero
# FEATURED_WINDOW_HOURS=30        # how far back a story can still be featured
# FEATURED_MIN_WEIGHT=45          # minimum headlineWeight to be featured
# Midnight Trends loop (generate_trends.py): reads Google Trends "Trending now", no key needed
# TREND_GEOS=US,GB,CA,AU,IN,NG,KE,ZA,GH,EG,DE,FR,ES,IT,NL,BR,MX,AR,JP,KR,ID,PH,PK,SG,TR,SA,AE,PL,SE,TH,VN,MY,NZ,IE
# TREND_INTERVAL_SECONDS=900      # how often Google Trends is read again
# TREND_MAX_ATTEMPTS=3            # tries (1h, 3h, 8h apart) before a trend that cannot be written is given up
# TREND_BLOCKLIST=word1,word2     # extra words that are never written about (adult terms are built in)

# Go live on the dashboard starts a loop that is not running. Set to 0 to disable that.
# LOOP_AUTOSTART=1

# How hard a story is tried before it is given up on (the Midnight Report never gives up)
# FACTCHECK_ROUNDS=8   # corrective rewrites after a failed fact-check, articles and trends (5-10)
# IMAGE_TRIES=10       # different image candidates tried per story (5-10)
# WRITE_TRIES=5        # tries to get a complete, not cut-off, draft per write (3-10)
